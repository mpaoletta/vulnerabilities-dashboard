# Base de la API que usa el browser. `/api` = mismo origen: en dev/preview lo reenvía el proxy de
# Vite y detrás de Funnel lo enruta `scripts/funnel-dashboard.sh`. Para otro host: https://api.ejemplo/api
VITE_API_BASE_URL=/api
# Destino del proxy `/api` de `npm run dev` / `npm run preview` (no llega al bundle). Default: :8000.
# API_PROXY_TARGET=http://127.0.0.1:8000
